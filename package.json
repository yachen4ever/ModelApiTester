{
  "name": "model-api-tester",
  "version": "1.0.0",
  "description": "Minimal LLM API testing tool with SQLite storage",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --compile --target=bun-linux-x64 --outfile model-api-tester"
  },
  "dependencies": {
    "bun:": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
